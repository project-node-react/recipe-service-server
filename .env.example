# --- Server ---
PORT=3000
NODE_ENV=development
# Список разрешённых origin для CORS, через запятую (без пробелов)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Postgres (используется docker-compose И DATABASE_URL ниже — держите их в синхроне) ---
POSTGRES_USER=recipe_user
POSTGRES_PASSWORD=recipe_pass
POSTGRES_DB=recipe_db
POSTGRES_PORT=5432

# --- Prisma ---
DATABASE_URL="postgresql://recipe_user:recipe_pass@localhost:5432/recipe_db?schema=public"

# --- Auth ---
# access-токен живёт 15 минут, refresh — 7 дней (см. src/constants/time.ts)
JWT_SECRET=change_me_to_a_long_random_string

# --- Cloudinary (аватарки и фото рецептов) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- pgAdmin (опционально, профиль "tools") ---
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
